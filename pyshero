def decor(tracker=True, aide=False):
    canvas.delete("all")
    for yy in range(0, H, 5):
        canvas.create_line(0, yy, W, yy, fill=SCAN)
    for xx in range(0, W, GRID):
        canvas.create_line(xx, 0, xx, H, fill=C_GRID)
    for yy in range(0, H, GRID):
        canvas.create_line(0, yy, W, yy, fill=C_GRID)
    if tracker:
        cx, cy = W / 2, H / 2
        for r in RINGS:
            canvas.create_oval(cx - r, cy - r, cx + r, cy + r, outline=DIM)
        canvas.create_line(cx - 14, cy, cx + 14, cy, fill=MID)
        canvas.create_line(cx, cy - 14, cx, cy + 14, fill=MID)
        canvas.create_oval(cx - 4, cy - 4, cx + 4, cy + 4, outline=BRIGHT, width=2)
    corner_brackets()
    hud_labels("MOTION TRACKER" if tracker else "PLAN / SCHEMATIC")
    if aide:
        panneau_aide()


def draw_sweep(angle):
    canvas.delete("sweep")
    if not nav["actif"]:
        return
    cx, cy = W / 2, H / 2
    rmax = max(RINGS)
    a = math.radians(angle)
    canvas.create_line(cx, cy, cx + rmax * math.cos(a), cy - rmax * math.sin(a),
                       fill=BRIGHT, width=2, tags="sweep")


def redraw_all(tracker=True):
    decor(tracker)
    for x, y, col in points:
        draw_point(x, y, col)


def draw_free_cells():
    for c in free_cells:
        x, y = cell_center(c)
        sx, sy = to_screen(x, y)
        canvas.create_rectangle(sx - 1, sy - 1, sx + 1, sy + 1, fill=FREE, outline="")


def position():
    p = droid.get_location()
    return p["x"], p["y"]


def projeter(x, y, cap, distance=PROJ_MUR):
    a = math.radians(cap)
    return x + distance * math.sin(a), y + distance * math.cos(a)


def placer_point(x, y, col):
    if maj_bbox(x, y):
        fit_to_bbox()
        redraw_all(tracker=True)
    else:
        draw_point(x, y, col)


def add_trace(x, y):
    last = derniere_trace[0]
    if last is not None:
        d = math.hypot(x - last[0], y - last[1])
        if d > MAX_SAUT:
            derniere_trace[0] = (x, y)
            return
        for px, py in sample_segment(last, (x, y)):
            mark_free(px, py)
        if d < PAS_MIN_TRACE:
            return
    else:
        mark_free(x, y)
    derniere_trace[0] = (x, y)
    points.append((x, y, False))
    placer_point(x, y, False)


def add_occ(x, y):
    last = derniere_occ[0]
    if last is not None and math.hypot(x - last[0], y - last[1]) < DIST_MIN_OCC:
        return
    derniere_occ[0] = (x, y)
    points.append((x, y, True))
    placer_point(x, y, True)


def enregistrer_mur(x, y):
    px, py = projeter(x, y, nav["cap"])
    add_occ(px, py)


def ligne(cap):
    nav["cap"] = cap % 360
    droid.set_heading(int(round(cap)) % 360)
    reset_collision_state()
    droid.set_speed(VITESSE)
    while nav["actif"] and not detect_collision():
        add_trace(*position())
        yield PERIODE_MS
    droid.set_speed(0)
    x, y = position()
    if det["hit"]:
        enregistrer_mur(x, y)
    add_trace(x, y)


def sequence_exploration():
    while nav["actif"]:
        for base in range(0, 360, 90):
            status.set(f">> SCAN  |  AXE {base:03d}Â°  |  CONTACTS {n_contacts():03d}  TRACE {len(points):04d}")

            yield from ligne(base)
            if not nav["actif"]:
                return
            yield from ligne((base + 180) % 360)
            if not nav["actif"]:
                return

            nav["cap"] = (base - 90) % 360
            reset_collision_state()
            droid.roll((base - 90) % 360, ROLL_VITESSE, ROLL_DUREE)
            touche = False
            for _ in range(4):
                if not nav["actif"]:
                    droid.set_speed(0)
                    return
                x, y = position()
                add_trace(x, y)
                if detect_collision():
                    enregistrer_mur(x, y)
                    touche = True
                    break
                yield PERIODE_ROLL_MS
            droid.set_speed(0)
            if touche:
                reset_collision_state()
                continue

            yield from ligne(base)
            if not nav["actif"]:
                return
            yield from ligne((base + 180) % 360)
            if not nav["actif"]:
                return


def run_movement_loop(generator):
    if not nav["actif"]:
        return
    try:
        delay = next(generator)
        window.after(delay, lambda: run_movement_loop(generator))
    except StopIteration:
        nav["actif"] = False


def radar_tick():
    if not nav["actif"]:
        canvas.delete("sweep")
        return
    nav["sweep"] = (nav["sweep"] + 8) % 360
    draw_sweep(nav["sweep"])
    window.after(120, radar_tick)


def n_contacts():
    return sum(1 for _, _, col in points if col)


def reset_bbox():
    bbox.update(minx=None, maxx=None, miny=None, maxy=None, span=START_VIEW_CM)


def reset_carte(aide=True):
    points.clear()
    free_cells.clear()
    derniere_trace[0] = None
    derniere_occ[0] = None
    det.update(hit=False, glissements=0, blocages=0)
    reset_bbox()
    fit_to_bbox()
    decor(tracker=True, aide=aide)


def start():
    if nav["actif"]:
        return
    reset_carte(aide=False)
    nav.update(actif=True, cap=0.0, sweep=0)
    try:
        droid.set_stabilization(True)
    except Exception:
        pass
    reset_collision_state()
    status.set(">> SCAN EN COURS")
    run_movement_loop(sequence_exploration())
    radar_tick()


def stop():
    nav["actif"] = False
    try:
        droid.set_speed(0)
        droid.stop_roll()
    except Exception:
        pass
    canvas.delete("sweep")
    status.set(">> SCAN INTERROMPU")


def plan():
    stop()
    if len(points) < 3:
        status.set(">> DONNEES INSUFFISANTES")
        return

    reset_bbox()
    for x, y, _col in points:
        maj_bbox(x, y)
    for c in free_cells:
        maj_bbox(*cell_center(c))
    fit_to_bbox()

    decor(tracker=False)
    draw_free_cells()
    for x, y, col in points:
        draw_point(x, y, col)

    cols = [(x, y) for x, y, col in points if col]

    contour = enveloppe_convexe([cell_center(c) for c in free_cells] + cols)
    aire_piece = 0.0
    if len(contour) >= 3:
        aire_piece = aire_m2(contour)
        coords = []
        for p in contour + [contour[0]]:
            sx, sy = to_screen(*p)
            coords += [sx, sy]
        canvas.create_line(*coords, fill=BRIGHT, width=3)

    interieurs = [(x, y) for (x, y) in cols
                  if len(contour) >= 3 and dist_au_contour((x, y), contour) > D_INTERIEUR_OBSTACLE]

    aire_obstacles, n_obs = 0.0, 0
    for amas in regrouper(interieurs, R_CLUSTER):
        if len(amas) < MIN_CLUSTER:
            continue
        o = enveloppe_convexe(amas)
        if len(o) < 3:
            continue
        n_obs += 1
        aire_obstacles += aire_m2(o)
        coords = []
        for p in o + [o[0]]:
            sx, sy = to_screen(*p)
            coords += [sx, sy]
        canvas.create_polygon(*coords, fill="", outline=OBST, width=2)
        ox, oy = moyenne_pts(o)
        tx, ty = to_screen(ox, oy)
        canvas.create_text(tx, ty, text="OBST", fill=OBST, font=SMALL)

    aire = max(aire_piece - aire_obstacles, 0.0)
    canvas.create_text(W / 2, H - 40, text=f"SURFACE  {aire:.2f} mÂ²", fill=HOT, font=BIGF)
    status.set(f">> PLAN ETABLI  |  SURFACE {aire:.2f} mÂ²  |  OBSTACLES: {n_obs}")


def purge():
    stop()
    reset_carte(aide=True)
    afficher_67()
    status.set(">> SYSTEME PRET")


def quitter():
    nav["actif"] = False
    try:
        droid.set_speed(0)
        droid.stop_roll()
    except Exception:
        pass
    window.destroy()


