def _on_collision(api):
    if time.time() - det["t_capteur"] >= COLLISION_COOLDOWN:
        det["hit"] = True
        det["t_capteur"] = time.time()


droid.register_event(EventType.on_collision, _on_collision)


def detect_collision():
    if det["hit"]:
        return True

    v = droid.get_velocity()
    vitesse = math.hypot(v["x"], v["y"])
    cap = droid.get_heading()

    if vitesse > VITESSE_SEUIL:
        direction = math.degrees(math.atan2(v["x"], v["y"])) % 360
        ecart = abs((direction - cap + 180) % 360 - 180)
        det["glissements"] = det["glissements"] + 1 if ecart > ECART_CAP else 0
        if det["glissements"] >= N_GLISSEMENT:
            det.update(hit=True, glissements=0)
    else:
        det["glissements"] = 0

    if vitesse < VITESSE_SEUIL and (time.time() - det["t_demarrage"]) > DELAI_BLOCAGE:
        det["blocages"] += 1
        if det["blocages"] >= N_BLOCAGE:
            det.update(hit=True, blocages=0)
    else:
        det["blocages"] = 0

    return det["hit"]


def reset_collision_state():
    det.update(hit=False, glissements=0, blocages=0, t_demarrage=time.time())


def clamp(v, a, b):
    return max(a, min(b, v))


def cell_of(x, y):
    return int(round(x / CELL_CM)), int(round(y / CELL_CM))


def cell_center(c):
    return c[0] * CELL_CM, c[1] * CELL_CM


def mark_free(x, y):
    c = cell_of(x, y)
    for dx in (-1, 0, 1):
        for dy in (-1, 0, 1):
            free_cells.add((c[0] + dx, c[1] + dy))


def sample_segment(a, b, step=PATH_STEP_CM):
    ax, ay = a
    bx, by = b
    d = math.hypot(bx - ax, by - ay)
    if d <= 0:
        return [(bx, by)]
    n = max(1, int(math.ceil(d / step)))
    return [(ax + (bx - ax) * i / n, ay + (by - ay) * i / n) for i in range(n + 1)]


def enveloppe_convexe(pts):
    pts = sorted(set((round(x, 3), round(y, 3)) for x, y in pts))
    if len(pts) <= 2:
        return pts

    def cross(o, a, b):
        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

    bas = []
    for p in pts:
        while len(bas) >= 2 and cross(bas[-2], bas[-1], p) <= 0:
            bas.pop()
        bas.append(p)
    haut = []
    for p in reversed(pts):
        while len(haut) >= 2 and cross(haut[-2], haut[-1], p) <= 0:
            haut.pop()
        haut.append(p)
    return bas[:-1] + haut[:-1]


def aire_m2(poly):
    n = len(poly)
    if n < 3:
        return 0.0
    s = sum(poly[i][0] * poly[(i + 1) % n][1] - poly[(i + 1) % n][0] * poly[i][1] for i in range(n))
    return abs(s) / 2.0 / 10000.0


def dist_point_segment(p, a, b):
    if a == b:
        return math.hypot(p[0] - a[0], p[1] - a[1])
    dx, dy = b[0] - a[0], b[1] - a[1]
    t = clamp(((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / (dx * dx + dy * dy), 0, 1)
    return math.hypot(p[0] - (a[0] + t * dx), p[1] - (a[1] + t * dy))


def dist_au_contour(p, poly):
    if len(poly) < 2:
        return 0.0
    return min(dist_point_segment(p, poly[i], poly[(i + 1) % len(poly)]) for i in range(len(poly)))


def regrouper(pts, r):
    pts = list(pts)
    used = [False] * len(pts)
    out = []
    for i in range(len(pts)):
        if used[i]:
            continue
        pile = [i]
        used[i] = True
        comp = [pts[i]]
        while pile:
            j = pile.pop()
            for k in range(len(pts)):
                if not used[k] and math.hypot(pts[j][0] - pts[k][0], pts[j][1] - pts[k][1]) <= r:
                    used[k] = True
                    pile.append(k)
                    comp.append(pts[k])
        out.append(comp)
    return out


def moyenne_pts(pts):
    if not pts:
        return 0.0, 0.0
    return sum(p[0] for p in pts) / len(pts), sum(p[1] for p in pts) / len(pts)


def to_screen(x, y):
    r = view["rot"]
    c, s = math.cos(r), math.sin(r)
    xr, yr = x * c - y * s, x * s + y * c
    return xr * view["scale"] + view["ox"], view["oy"] - yr * view["scale"]


def draw_point(x, y, col):
    sx, sy = to_screen(x, y)
    if col:
        canvas.create_oval(sx - 5, sy - 5, sx + 5, sy + 5, outline=BLIP, tags="pt")
        canvas.create_oval(sx - 2, sy - 2, sx + 2, sy + 2, fill=HOT, outline="", tags="pt")
    else:
        canvas.create_oval(sx - 1, sy - 1, sx + 1, sy + 1, fill=DIM, outline="", tags="pt")


def maj_bbox(x, y):
    if bbox["minx"] is None:
        bbox.update(minx=x, maxx=x, miny=y, maxy=y, span=START_VIEW_CM)
        return True
    old_span = bbox["span"]
    changed = False
    if x < bbox["minx"]:
        bbox["minx"] = x; changed = True
    if x > bbox["maxx"]:
        bbox["maxx"] = x; changed = True
    if y < bbox["miny"]:
        bbox["miny"] = y; changed = True
    if y > bbox["maxy"]:
        bbox["maxy"] = y; changed = True
    if not changed:
        return False
    span = max(bbox["maxx"] - bbox["minx"], bbox["maxy"] - bbox["miny"], START_VIEW_CM)
    if span > old_span * (1 + REFIT_DELTA):
        bbox["span"] = span
        return True
    return False


def fit_to_bbox():
    if bbox["minx"] is None:
        view.update(scale=SCALE_MAX, ox=W / 2, oy=H / 2, rot=0.0)
        return
    cx = (bbox["minx"] + bbox["maxx"]) / 2
    cy = (bbox["miny"] + bbox["maxy"]) / 2
    dx = max(bbox["maxx"] - bbox["minx"], START_VIEW_CM)
    dy = max(bbox["maxy"] - bbox["miny"], START_VIEW_CM)
    s = clamp(min((W - 2 * MARGE_VUE) / dx, (H - 2 * MARGE_VUE) / dy), SCALE_MIN, SCALE_MAX)
    view["scale"] = s
    view["ox"] = W / 2 - s * cx
    view["oy"] = H / 2 + s * cy


def corner_brackets():
    L, m = 26, 14
    for (cx, cy, sx, sy) in [(m, m, 1, 1), (W - m, m, -1, 1), (m, H - m, 1, -1), (W - m, H - m, -1, -1)]:
        canvas.create_line(cx, cy, cx + sx * L, cy, fill=BRIGHT, width=2)
        canvas.create_line(cx, cy, cx, cy + sy * L, fill=BRIGHT, width=2)


